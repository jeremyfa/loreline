// Choice options: text, trailing conditions, transitions and brace blocks.

beat Start
  choice
    Take it if gold > 3
//  ^^^^^^^ string.unquoted
//          ^^ keyword.control
//             ^^^^ variable.other
//                  ^ keyword.operator
      Taken.
    Go if ok is true -> End
//  ^^ string.unquoted
//     ^^ keyword.control
//           ^^ keyword.control
//              ^^^^ constant.language
//                   ^^ keyword.control.flow
//                      ^^^ entity.name.type.beat
    Show pass if hasPass {
//  ^^^^^^^^^ string.unquoted
//            ^^ keyword.control
//               ^^^^^^^ variable.other
//            ^^^^^^^^^^ - string.unquoted
      Passed.
    }
    Run if scared. Otherwise stay.
//  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.unquoted
      Ran.

beat End
  Done.

beat More
  choice
    "Quoted option"
//  ^^^^^^^^^^^^^^^ string.quoted.double
    "Quoted option" if gold > 0
//  ^^^^^^^^^^^^^^^ string.quoted.double
//                  ^^ keyword.control
//                     ^^^^ variable.other
    "Quoted option" -> End
//  ^^^^^^^^^^^^^^^ string.quoted.double
//                  ^^ keyword.control.flow
//                     ^^^ entity.name.type.beat
    <b>Bold</b> option $name
//   ^ storage.modifier.metadata
//     ^^^^ string.unquoted
//              ^^^^^^ string.unquoted
//                      ^^^^ variable.other
    Option with <i>italic</i> inside
//  ^^^^^^^^^^^^ string.unquoted
//              ^ punctuation.definition.tag
//               ^ storage.modifier.metadata
//                ^ punctuation.definition.tag
//                 ^^^^^^ string.unquoted
//                         ^ storage.modifier.metadata
    <whisper> Tag opening the option
//  ^ punctuation.definition.tag
//   ^^^^^^^ storage.modifier.metadata
//          ^ punctuation.definition.tag
//            ^^^^^^^^^^^^^^^^^^^^^^ string.unquoted
    Wait <pause=$delay> a moment
//       ^ punctuation.definition.tag
//        ^^^^^ storage.modifier.metadata
//             ^ punctuation.definition.tag
//               ^^^^^ variable.other
//                    ^ punctuation.definition.tag
//                      ^^^^^^^^ string.unquoted
    Escapes $$ and ## and \n here
//          ^^ constant.character.escape
//                 ^^ constant.character.escape
//                        ^^ constant.character.escape
//                          ^^^^^ string.unquoted
    "Quoted \"escaped\" option"
//  ^^^^^^^^ string.quoted.double
//          ^^ constant.character.escape
//            ^^^^^^^ string.quoted.double
//                   ^^ constant.character.escape
    "Quoted <b>tag</b> option" -> End
//          ^ punctuation.definition.tag
//           ^ storage.modifier.metadata
//             ^^^ string.quoted.double
//                             ^^ keyword.control.flow
    - <b>Once</b> option with $$
//  ^^ string.unquoted
//    ^ punctuation.definition.tag
//     ^ storage.modifier.metadata
//       ^^^^ string.unquoted
//                            ^^ constant.character.escape
    Leave -> End
//  ^^^^^ string.unquoted
//        ^^ keyword.control.flow
//           ^^^ entity.name.type.beat
    Water if (gold > 0 and thirsty)
//  ^^^^^ string.unquoted
//        ^^ keyword.control
//            ^^^^ variable.other
//                     ^^^ keyword.control
//                         ^^^^^^^ variable.other
    + Inserted(sarah)
//  ^ keyword.control.flow
//    ^^^^^^^^ entity.name.type.beat
//             ^^^^^ variable.other
    + beat(kind + "Options") if showBonus
//  ^ keyword.control.flow
//    ^^^^ entity.name.function
//         ^^^^ variable.other
//                ^^^^^^^^^ string.quoted.double
//                           ^^ keyword.control
//                              ^^^^^^^^^ variable.other
    + Extra if (visits > 2)
//    ^^^^^ entity.name.type.beat
//          ^^ keyword.control
//              ^^^^^^ variable.other
    + Extra // comment
//    ^^^^^ entity.name.type.beat
//          ^^^^^^^^^^ comment.line.double-slash
    + Extra /* c */ // d
//    ^^^^^ entity.name.type.beat
//          ^^^^^^^ comment.block
//                  ^^^^ comment.line.double-slash
    + /* c */ Extra
//    ^^^^^^^ comment.block
//            ^^^^^ entity.name.type.beat
    + Extra if count > 5
//  ^ keyword.control.flow
//    ^^^^^ entity.name.type.beat
//          ^^ keyword.control
//             ^^^^^ variable.other
//                   ^ keyword.operator
//                     ^ constant.numeric
    + Extra if a and b
//    ^^^^^ entity.name.type.beat
//             ^ variable.other
//               ^^^ keyword.control
//                   ^ variable.other
    + Extra if count >= 5 and ok // c
//    ^^^^^ entity.name.type.beat
//             ^^^^^ variable.other
//                        ^^^ keyword.control
//                            ^^ variable.other
//                               ^^^^ comment.line.double-slash
    + Extra if items.length > 0
//    ^^^^^ entity.name.type.beat
//             ^^^^^ variable.other
//                   ^^^^^^ variable.other
    + Extra if "a" == name
//    ^^^^^ entity.name.type.beat
//             ^^^ string.quoted.double
//                    ^^^^ variable.other
  choice {
//^^^^^^ keyword.control.choice
//       ^ punctuation.section.block.begin
    Braced option {
//  ^^^^^^^^^^^^^ string.unquoted
//                ^ punctuation.section.block.begin
      Inside.
//    ^^^^^^^ string.unquoted
    }
//  ^ punctuation.section.block.end
    Second option
//  ^^^^^^^^^^^^^ string.unquoted
  }
//^ punctuation.section.block.end
  After.
//^^^^^^ string.unquoted

beat Calls
  choice
    Buy tea if has_item("key")
//  ^^^^^^^ string.unquoted
//          ^^ keyword.control
//             ^^^^^^^^ entity.name.function
//                      ^^^^^ string.quoted.double
      Bought.
    Ask again if Helper.visits() > 1
//  ^^^^^^^^^ string.unquoted
//            ^^ keyword.control
//               ^^^^^^ entity.name.type.beat
//                      ^^^^^^ entity.name.function.method
      Asked.
    Order if items.contains("tea") else nothing
//  ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.unquoted
      Ordered.
