// A comment starting with `@word` holds directives for the editor: each
// `@word` stands out, with the rules it names, the rest stays a comment.

// @ignore-all unreachable-beat
// <-- comment.line.double-slash
// ^^^^^^^^^^^ storage.modifier.metadata.directive
//             ^^^^^^^^^^^^^^^^ variable.parameter.directive
//             ^^^^^^^^^^^^^^^^ comment.line.double-slash
//             ^^^^^^^^^^^^^^^^ - storage.modifier.metadata.directive
// @error-in-file unknown-name, undeclared-assignment
// ^^^^^^^^^^^^^^ storage.modifier.metadata.directive
//                ^^^^^^^^^^^^ variable.parameter.directive
//                              ^^^^^^^^^^^^^^^^^^^^^ variable.parameter.directive
// @ignore-in-file
// ^^^^^^^^^^^^^^^ storage.modifier.metadata.directive

beat Start
  Value is $name. // @ignore unknown-name @warn shadowing
//                ^^ comment.line.double-slash
//                   ^^^^^^^ storage.modifier.metadata.directive
//                           ^^^^^^^^^^^^ variable.parameter.directive
//                           ^^^^^^^^^^^^ - storage.modifier.metadata.directive
//                                        ^^^^^ storage.modifier.metadata.directive
//                                              ^^^^^^^^^ variable.parameter.directive
  // A comment with an email@example.com is ordinary
//                          ^^^^^^^^^^^^ - storage.modifier.metadata.directive
//     ^^^^^^^ - variable.parameter.directive
  // @ignore
//   ^^^^^^^ storage.modifier.metadata.directive
  Done.
