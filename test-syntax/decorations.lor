// Constructs that get decorations on top of the grammar: text,
// plural pipes, choice options, once-only options and when rules played once. The report shows them
// with those decorations, the assertions check the grammar underneath.

state
  count: 3

beat Start
  $count drink|drinks
//^ punctuation.definition.block.begin
// ^^^^^ variable.other
//       ^^^^^^^^^^^^ string.unquoted

  $count (cold drink|cold drinks) left
//       ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.unquoted

  "Quoted narration, with $count items."
//^^^^^^^^^^^^^^^^^^^^^^^ string.quoted.double
//                         ^^^^^ variable.other

  A long line of narration that goes on and on, long enough to wrap in the report, so that its continuation lines show the hanging indent.
//^^^^^^^^^^^ string.unquoted
  choice
    - Ask once
//  ^^^^^^^^^^ string.unquoted
      Asked.
    Leave if count > 1
//  ^^^^^ string.unquoted
//        ^^ keyword.control
      Left.
  when
    count > 2 and count < 10 // many
//  ^^^^^ variable.other
//            ^^^ keyword.control
//                           ^^^^^^^ comment.line.double-slash
      Quite a few.
//    ^^^^^^^^^^^^ string.unquoted
    - count is 1
//  ^ keyword.control.once
//    ^^^^^ variable.other
      Just one, said once.
//    ^^^^^^^^^^^^^^^^^^^^ string.unquoted
    + Rumors if count > 5
//    ^^^^^^ entity.name.type.beat
    - always {
//    ^^^^^^ keyword.control.always
      Once, whatever the count.
    }
    always
//  ^^^^^^ keyword.control.always
      Some.
//    ^^^^^ string.unquoted

beat Rumors
  when
    always
      Rumors.
