// A when block picks one rule by saliency. Narration that starts with "when"
// stays text.

character bob
  name: Bob

beat Start
  when you are ready, come back.
//^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.unquoted
  when she arrives, it rains.
//^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.unquoted
  when first light comes
//^^^^^^^^^^^^^^^^^^^^^^ string.unquoted
  Say when.
//^^^^^^^^^ string.unquoted
  bob: Tell me when you are ready.
//     ^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.unquoted.dialogue

beat Blocks
  when
//^^^^ keyword.control.when
    mood is "angry" and gold > 3
//  ^^^^ variable.other
//       ^^ keyword.control
//          ^^^^^^^ string.quoted.double
//                  ^^^ keyword.control
//                             ^ constant.numeric
      Get out!
//    ^^^^^^^^ string.unquoted
    - met_before
//  ^ keyword.control.once
//    ^^^^^^^^^^ variable.other
      Oh, it is you again.
//    ^^^^^^^^^^^^^^^^^^^^ string.unquoted
    + Rumors if (visits > 2)
//  ^ keyword.control.flow
//    ^^^^^^ entity.name.type.beat
//           ^^ keyword.control
//               ^^^^^^ variable.other
//                        ^ constant.numeric
    + Gossip
//  ^ keyword.control.flow
//    ^^^^^^ entity.name.type.beat
    + Rumors if visits > 2 and ready
//  ^ keyword.control.flow
//    ^^^^^^ entity.name.type.beat
//           ^^ keyword.control
//              ^^^^^^ variable.other
//                         ^^^ keyword.control
//                             ^^^^^ variable.other
    true
//  ^^^^ constant.language
      when you come back, knock.
//    ^^^^^^^^^^^^^^^^^^^^^^^^^^ string.unquoted
  After.
//^^^^^^ string.unquoted
  when first
//^^^^ keyword.control.when
//     ^^^^^ entity.name.function.strategy
    not ready
//  ^^^ keyword.control
//      ^^^^^ variable.other
      when pick
//    ^^^^ keyword.control.when
//         ^^^^ entity.name.function.strategy
        true
//      ^^^^ constant.language
          Nested.
//        ^^^^^^^ string.unquoted
    - true
//  ^ keyword.control.once
//    ^^^^ constant.language
      bob: Once.
//    ^^^ entity.name.class
//         ^^^^^ string.unquoted.dialogue
  when {
//^^^^ keyword.control.when
//     ^ punctuation.definition.block.begin
    ready {
//  ^^^^^ variable.other
//        ^ punctuation.definition.block.begin
      Go.
//    ^^^ string.unquoted
    }
  }
  when she arrives, it rains.
//^^^^^^^^^^^^^^^^^^^^^^^^^^^ string.unquoted
