state
  // Money the player carries
  gold: 10

character bob
  name: Bob
  mood: 3

character guard
  role: watch

function pay(amount, tip = 0)
  gold = gold - amount - tip
  return gold

beat Start
  bob: Hello there.
  The weather is nice.
  Gold is $gold and mood is ${bob.mood}.
  if gold > 5 and true
    -> Shop(3)
  -> .

// The shop, open every day
beat Shop(price, discount = 2)
  Price is $price.
  new state
    visits: 0
  choice
    Leave
      -> .

