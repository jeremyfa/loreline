state
  gold: 10
  xp: 0

character bob
  name: Bob
  mood: 3
  trust: 1

character carl
  name: Carl

character dana
  name: Dana

beat Start
  bob: Hello there.
  bob.mood = 5
  gold = gold + 1
  Carl is $carl.
  Trust is ${bob.trust} and xp is $xp.
  -> Shop

beat Shop
  gold = 0

beat Quiet
  Nothing happens here.

