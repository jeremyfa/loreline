// Keywords join the names offered on a line of their own, and nothing is
// offered once one is typed in full, so Enter goes to the next line. (The
// cases below are found by their first occurrence: keep them out of here.)

state
  gold: 0

character bob
  name: Bob

beat Start
  if gold > 0
    Rich.
  else
    Poor.
  els
  choi
  choice
    Go
      -> elsewhere
  x = gol
  -> els

beat elsewhere
  Hi.

beat Choices
  Hey.

