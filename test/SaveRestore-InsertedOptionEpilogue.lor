// Saving after an option that comes from an insertion has been picked, while
// an epilogue runs (in the parent beat, or in a middle inserted beat), must
// resume at that exact point, with the temporary state of that beat.

beat Start
  new state
    label: "start"
  choice
    Start option
      Picked at start with $label.
    + Level1
  Back at start with $label.

  Start done with $label.

beat Level1
  new state
    label: "level1"
  choice
    Level1 option
      Picked at level1 with $label.
    + Level2
  Back at level1 with $label.

beat Level2
  new state
    label: "level2"
  choice
    Level2 option
      Picked at level2 with $label.
  Back at level2 with $label.

/*
<test>
- choices: [1]
  saveAtDialogue: 2
  expected: |
    + Start option
    + Level1 option
    + Level2 option

    ~ Picked at level1 with level1.

    ~ Back at level1 with level1.

    ~ Back at start with start.

    ~ Back at start with start.

    ~ Start done with start.
- choices: [2]
  saveAtDialogue: 3
  expected: |
    + Start option
    + Level1 option
    + Level2 option

    ~ Picked at level2 with level2.

    ~ Back at level2 with level2.

    ~ Back at level1 with level1.

    ~ Back at start with start.

    ~ Back at start with start.

    ~ Start done with start.
- choices: [2]
  saveAtDialogue: 2
  expected: |
    + Start option
    + Level1 option
    + Level2 option

    ~ Picked at level2 with level2.

    ~ Back at level2 with level2.

    ~ Back at level1 with level1.

    ~ Back at level1 with level1.

    ~ Back at start with start.

    ~ Start done with start.
</test>
*/
