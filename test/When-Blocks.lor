// When blocks nested in a rule, written with braces, and inside a choice option.

state
  hungry: true
  thirsty: false

beat Start
  when
    hungry
      You are hungry.
      when {
        thirsty {
          And thirsty.
        }
        true {
          But not thirsty.
        }
      }
    true
      You are fine.

  choice
    Eat
      when first
        hungry
          You eat.
        true
          You are not hungry.
    Leave
      Bye.

/*
<test>
- choices: [0]
  expected: |
    ~ You are hungry.

    ~ But not thirsty.

    + Eat
    + Leave

    ~ You eat.
</test>
*/
