// The same rules in the code of functions: equality, ordering, truthiness,
// `switch` cases and loops.

character bob
  name: Bob

state
  n0: 0
  n1: 1
  n5: 5
  f5: 5.0
  n55: 5.5
  nm2: -2
  n9: 9
  n16: 16
  n1000: 1000
  h: 0.5
  s0: "0"
  s1: "1"
  s5: "5"
  s5sp: " 5 "
  s50: "5.0"
  s55: "5.5"
  sm2: "-2"
  s10: "10"
  s1e3: "1e3"
  sdot5: ".5"
  shex: "0x10"
  sabc: "abc"
  sempty: ""
  sspace: " "
  strue: "true"
  sfalse: "false"
  sTrue: "True"
  sHelper: "Helper"
  sbob: "bob"
  yes: true
  no: false
  nothing: null
  arr0: []
  arr0b: []
  arr5: [5]
  obj: { a: 1 }
  obj2: { a: 1 }
  ref: null
  ref2: null

function eq(a, b)
  return a == b

function ne(a, b)
  return a != b

function lt(a, b)
  return a < b

function ge(a, b)
  return a >= b

function truthy(v)
  if v
    return "truthy"
  return "falsy"

function negate(v)
  return !v

function both(v)
  return v and true

function either(v)
  return v or false

function ternaryOf(v)
  return v ? "a" : "b"

function kind(v)
  switch v
    case 5
      return "five"
    case "abc"
      return "abc"
    case true
      return "yes"
    default
      return "other"

function countdown(n)
  var steps = 0
  while n
    n = n - 1
    steps = steps + 1
  return steps

function literal(i)
  var all = [5 == "5", 0 == "", true == "true", true == 1, null == 0, "10" > 9]
  return all[i]

beat Start
  ref = Helper
  ref2 = Helper

  Fn pair n5 with f5 gives ${eq(n5, f5)} and ${ne(n5, f5)}.

  Fn pair n5 with n55 gives ${eq(n5, n55)} and ${ne(n5, n55)}.

