// string() writes a value as interpolation does, the same on every target, and
// bool() reads it with the truthiness of conditions.

character bob
  name: Bob

state
  ref: null
  nothing: null

beat Start
  ref = Helper

  String gives ${string(5.0)} ${string(1 / 3)} ${string(null)} ${string(true)} ${string("text")} ${string(-0.0)}.

  String of containers gives ${string([1, "a", null, 2.5])} ${string({ a: 1, b: [true] })} ${string([])} ${string({})}.

  String of references gives ${string(bob)} ${string(ref)}.

  Bool gives ${bool("0")} ${bool("false")} ${bool(0.0)} ${bool([])} ${bool("")} ${bool(null)} ${bool([0])} ${bool(-1)}.

beat Helper
  Never played.

/*
<test>
- expected: |
    ~ String gives 5 0.333333333333333 null true text 0.

    ~ String of containers gives [1, a, null, 2.5] {a: 1, b: [true]} [] {}.

    ~ String of references gives Bob Helper.

    ~ Bool gives true true false false false false true true.
</test>
*/
