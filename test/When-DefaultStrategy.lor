// Default strategy of a when block: the rule with the highest score wins (clauses
// joined by a top-level `and`), then the one played least recently, then the
// first one written. `true` scores 0. With nothing eligible, nothing plays.

state
  mood: "angry"
  gold: 5
  ready: true

beat Start
  Talk()
  Talk()
  mood = "calm"
  Talk()
  gold = 0
  Talk()
  Greet()
  Greet()
  Greet()
  Greet()
  Greet()
  Maybe()
  Fallback()
  Fallback()

beat Talk
  when
    mood is "angry" and gold > 3
      Get out, and take your money!
    mood is "angry"
      Leave me alone.
    gold > 3
      Nice purse.
    true
      Hello.

beat Greet
  when
    ready
      First greeting.
    ready
      Second greeting.
    ready
      Third greeting.

beat Maybe
  when
    not ready
      Not shown.
  After maybe.

// `true` requires nothing: even played least recently, it loses against a rule
// with a criterion
beat Fallback
  when
    ready
      Ready again.
    true
      Fallback.

/*
<test>
- expected: |
    ~ Get out, and take your money!

    ~ Get out, and take your money!

    ~ Nice purse.

    ~ Hello.

    ~ First greeting.

    ~ Second greeting.

    ~ Third greeting.

    ~ First greeting.

    ~ Second greeting.

    ~ After maybe.

    ~ Ready again.

    ~ Ready again.
</test>
*/
