
character hero
  name: Robin
  title: Knight

state
  label: Hello World
  count: 0

// Basic unquoted string assign to character property
hero.name := Alex
"Name: $hero.name"

// Multi-word unquoted string
hero.title := Grand Wizard
"Title: $hero.title"

// Unquoted assign to state field
label := Goodbye World
"Label: $label"

// Numbers, booleans and null keep their type (not treated as strings)
label := 42
"Label 42: $label"

label := true
"Label true: $label"

label := false
"Label false: $label"

label := null
"Label null: $label"

// Interpolation in unquoted value
hero.name := Sir $hero.title
"Interpolated: $hero.name"

// Quotes inside an unquoted value are text, there is nothing to escape
label := wow "no need to escape quotes"
"Quotes: $label"

label := "a" and "b"
"Starts quoted: $label"

// A value that is only a quoted string is a quoted string
label := "quoted value"
"Fully quoted: $label"

// Bracket access assign
state
  items: ["Sword", "Shield"]
items[0] := Axe
"Item 0: ${items[0]}"

// Regular = still works for numeric assignment
count = 99
"Count: $count"

/*
<test>
- expected: |
    ~ Name: Alex

    ~ Title: Grand Wizard

    ~ Label: Goodbye World

    ~ Label 42: 42

    ~ Label true: true

    ~ Label false: false

    ~ Label null: null

    ~ Interpolated: Sir Grand Wizard

    ~ Quotes: wow "no need to escape quotes"

    ~ Starts quoted: "a" and "b"

    ~ Fully quoted: quoted value

    ~ Item 0: Axe

    ~ Count: 99
</test>
*/
