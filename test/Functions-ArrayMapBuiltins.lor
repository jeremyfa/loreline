// Array and map built-in functions given something else than an array or an
// object act on an empty one, the same on every target: nothing is added,
// lengths are 0, searches find nothing. Their results are written the same
// everywhere.

state
  nothing: null
  word: "abc"
  record: { b: 1, a: 2, B: 3 }

function inFunction()
  var list = null
  array_add(list, 1)
  return array_length(list) + " " + map_length(list) + " " + map_get(list, "a")

beat Start
  array_add(nothing, 1)
  array_add(word, 1)
  map_set(nothing, "a", 1)

  Arrays of nothing give ${array_length(nothing)} ${array_length(word)} ${array_has(nothing, 1)} ${array_index(nothing, 1)} [${array_join(nothing, ",")}] ${array_pop(nothing)} ${array_shift(nothing)} ${array_pick(nothing)}.

  Empty arrays give ${array_pop([])} ${array_shift([])} ${array_pick([])} [${array_join([], ",")}] ${array_sort([])} ${array_reverse([])}.

  Maps of nothing give ${map_length(nothing)} ${map_keys(nothing)} ${map_has(nothing, "a")} ${map_get(nothing, "a")} ${map_remove(nothing, "a")} ${map_copy(nothing)}.

  Maps give ${map_keys(record)} ${map_get(record, "z")} ${map_has(record, "a")} ${map_length(record)} ${map_get(record, "B")}.

  Join gives ${array_join([1, 2.5, true, null, "x", [1]], "-")} ${array_join(["a", "b"], 1)} ${array_join([0.1 + 0.2, 1 / 3], " ")}.

  Sort gives ${array_join(array_sort(["b", "A", "a", "é", "z", "Z"]), " ")} ${array_join(array_sort([10, "b", 2, true, 1.5, "a", null, -1]), " ")}.

  In a function gives ${inFunction()}.

/*
<test>
- expected: |
    ~ Arrays of nothing give 0 0 false -1 [] null null null.

    ~ Empty arrays give null null null [] [] [].

    ~ Maps of nothing give 0 [] false null false null.

    ~ Maps give [B, a, b] null true 3 3.

    ~ Join gives 1-2.5-true-null-x-[1] a1b 0.3 0.333333333333333.

    ~ Sort gives A Z a b z é -1 1.5 2 10 a b true null.

    ~ In a function gives 0 0 null.
</test>
*/
